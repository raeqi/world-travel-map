    {
      "id": "hokusai-nihonbashi",
      "theme": "hokusai",
      "name": "东京 · 日本桥",
      "lon": 139.774,
      "lat": 35.684,
      "country": "日本",
      "region": "东京都",
      "relation": "depicted-place",
      "desc": "《江户日本桥》把桥上人群推到画面近处，远方的城与富士山则压缩在同一视野中。桥、商贸活动与远山共同构成江户的城市意象，重点不只是寻找一座山。",
      "lookFor": "对照画中桥面被裁切的方式与今天的桥区，比较人群、交通和城市天际线。画面构图不是现代现场视线证明。",
      "sourceIds": [
        "hokusaiNihon"
      ],
      "coordinateStatus": "editorial-representative-not-navigation",
      "existingPlaceId": "nakasendo-tokyo",
      "precision": "bridge-area"
    },
    {
      "id": "hokusai-enoshima",
      "theme": "hokusai",
      "name": "江之岛与相模海岸",
      "lon": 139.48,
      "lat": 35.3,
      "country": "日本",
      "region": "神奈川县",
      "relation": "depicted-place",
      "desc": "北斋以江之岛和海岸活动构成富士山视角之一。同一座山在这里是海岸生活的远景；岛、岸和人在空间里的关系，比单独标注一座名山更值得看。",
      "lookFor": "先看版画中的岸线和人物，再观察现代岛岸景观。地图标记岛岸区域，不能据此推断画中每一条沙洲今天仍可通行。",
      "sourceIds": [
        "hokusaiEno"
      ],
      "coordinateStatus": "editorial-representative-not-navigation",
      "precision": "island-and-coast-area"
    },
    {
      "id": "hokusai-suwa",
      "theme": "hokusai",
      "name": "诹访湖",
      "lon": 138.08,
      "lat": 36.05,
      "country": "日本",
      "region": "长野县",
      "relation": "depicted-place",
      "desc": "《信州诹访湖》让湖泊与岸边建筑成为画面的主体，富士山被放入更远的背景。这是从高地水域理解富士山的入口，也能与同系列海岸和城市视角对照。",
      "lookFor": "观察湖面、岸线与远山的尺度关系；把它当作艺术地理阅读，不保证从湖区任一位置都能重现版画构图。",
      "sourceIds": [
        "hokusaiSuwa"
      ],
      "coordinateStatus": "editorial-representative-not-navigation",
      "precision": "lake-area"
    },
    {
      "id": "hokusai-kawaguchi",
      "theme": "hokusai",
      "name": "河口湖 · 御坂视角",
      "lon": 138.76,
      "lat": 35.52,
      "country": "日本",
      "region": "山梨县",
      "relation": "depicted-place",
      "desc": "《甲州三坂水面》中山体与倒影并不完全相同：水中的富士山带有积雪，画面上方的山却没有。馆方将其解释为可能把两个季节放进同一幅画面的视觉处理。",
      "lookFor": "先比较山与倒影的差别，再看湖面和渔船怎样形成安静的节奏。地图只标湖区，不宣称确定了北斋站立的机位。",
      "sourceIds": [
        "hokusaiMisaka"
      ],
      "coordinateStatus": "editorial-representative-not-navigation",
      "precision": "lake-area",
      "confidenceNote": "馆方的两个季节解释是可能性，不写成确定创作意图。"
    },
    {
      "id": "hokusai-ejiri",
      "theme": "hokusai",
      "name": "静冈清水 · 江尻地区",
      "lon": 138.48,
      "lat": 35.02,
      "country": "日本",
      "region": "静冈县",
      "relation": "depicted-place",
      "desc": "《骏州江尻》前景的行人与树木被大风搅动，纸张和斗笠飞起，远处富士山却保持静止。它把道路上的天气经验也纳入风景，而不仅描绘地标。",
      "lookFor": "比较前景的运动与远山的静止；在今天清水地区阅读旧东海道背景。没有足够证据把画中弯道定位为某一条现存街道。",
      "sourceIds": [
        "hokusaiEjiri"
      ],
      "coordinateStatus": "editorial-representative-not-navigation",
      "precision": "district"
    },
    {
      "id": "vermeer-kolk",
      "theme": "vermeer",
      "name": "代尔夫特 · 南侧港池",
      "lon": 4.361,
      "lat": 52.004,
      "country": "荷兰",
      "region": "南荷兰省",
      "relation": "depicted-place",
      "desc": "《代尔夫特风景》从城市南侧的水域观看城墙、城门与教堂。画家通过光线、横向层次和建筑位置调整来组织宁静感，因此它并非未经修改的城市测绘。",
      "lookFor": "比较水、城市和天空的三个横向层次，以及被照亮的新教堂塔楼。到现场看水城尺度，不把画中每座建筑都当作原位原貌保存。",
