  "themes": [
    {
      "id": "hokusai",
      "name": "北斋 · 富士山的多种看法",
      "kind": "art-and-landscape",
      "topology": "network",
      "tagline": "在桥、海岸和湖泊之间，寻找同一座山。",
      "introduction": "从《富岳三十六景》中挑选五处可关联的地景，比较城市交通、海岸、湖泊与远山如何进入画面。它是作品描绘地网络，不声称北斋按这个顺序旅行，也不把版画当成精确摄影。",
      "discoveryTerms": [
        "北斋",
        "浮世绘",
        "富士山",
        "湖泊",
        "日本桥",
        "江之岛"
      ],
      "visualDirection": "真实版画与地景说明并置；靛蓝作局部强调，保留原作色彩。先看整张画，再允许聚焦画中的山与人的比例。",
      "defaultView": {
        "lon": 138.7,
        "lat": 35.6,
        "zoom": 18
      },
      "heroMediaId": "hokusai-misaka"
    },
    {
      "id": "vermeer",
      "name": "维米尔 · 代尔夫特的光与日常",
      "kind": "art-and-city",
      "topology": "network",
      "tagline": "从一座城市的水面，看到一条普通的小街。",
      "introduction": "将两幅城市题材作品的描绘地，与分别收藏作品的海牙和阿姆斯特丹分开呈现。可先漫步代尔夫特，再选择是否去看原作；不是维米尔在三座城市之间的生平旅行。",
      "discoveryTerms": [
        "维米尔",
        "荷兰",
        "代尔夫特",
        "小街",
        "运河",
        "绘画"
      ],
      "visualDirection": "以《代尔夫特风景》的横向水城与《小街》的纵向砖墙对读；作品不被重度滤色，地图用克制的城市档案风格。",
      "defaultView": {
        "lon": 4.55,
        "lat": 52.2,
